# Analytics — no provider is installed (lib/analytics.ts drops every event until one is registered).
# Set after privacy policy review; the exact variable(s) depend on the provider chosen.

# Domain
NEXT_PUBLIC_SITE_URL=https://www.ezeirl.com


# --- EZE-FIT / EZE // FORM waitlist (server-side only; never NEXT_PUBLIC_) ---
# Legal gate: email collection stays OFF until the privacy policy is attorney-reviewed (AGENTS.md).
# Set to "true" (exact string) and redeploy to open the forms. Anything else = disabled.
WAITLIST_ENABLED=false
# Neon Postgres connection string (Vercel Marketplace). Required on Vercel for the waitlist
# and for website accounts. Apply the schema once with: npm run db:migrate
# On this computer, accounts are stored in data/site-accounts.sqlite when DATABASE_URL is empty.
DATABASE_URL=

# --- Personal-training client intake (/intake) ---
# Collects HEALTH information. Legal gate: keep OFF until the privacy policy is attorney-reviewed.
# Set to "true" (exact string) and redeploy to open the form. Uses DATABASE_URL + migration 0003.
INTAKE_ENABLED=false
