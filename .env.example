# Email provider — set ONE when approved and privacy policy is finalized
# NEXT_PUBLIC_EMAIL_API_KEY=your_api_key_here
# NEXT_PUBLIC_EMAIL_LIST_ID=your_list_id_here

# Analytics — set after privacy policy review
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# Domain
NEXT_PUBLIC_SITE_URL=https://www.ezeirl.com


# --- EZE-FIT / EZE // FORM waitlist (server-side only; never NEXT_PUBLIC_) ---
# Legal gate: email collection stays OFF until the privacy policy is attorney-reviewed (AGENTS.md).
# Set to "true" (exact string) and redeploy to open the forms. Anything else = disabled.
WAITLIST_ENABLED=false
# Neon Postgres connection string (Vercel Marketplace). Required when WAITLIST_ENABLED=true.
# Apply the schema once with: npm run db:migrate
DATABASE_URL=
